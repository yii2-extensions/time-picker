{
    "name": "yii2-extensions/time-picker",
    "type": "yii2-extension",
    "description": "Bootstrap time picker widget for Yii2 with canonical form submission.",
    "homepage": "https://github.com/yii2-extensions/time-picker",
    "keywords": [
        "yii2",
        "extension",
        "widget",
        "form",
        "time",
        "picker",
        "bootstrap",
        "jquery",
        "plugin"
    ],
    "license": "BSD-3-Clause",
    "support": {
        "docs": "https://github.com/yii2-extensions/time-picker/blob/main/docs/installation.md",
        "issues": "https://github.com/yii2-extensions/time-picker/issues",
        "source": "https://github.com/yii2-extensions/time-picker"
    },
    "authors": [
        {
            "name": "Kartik Visweswaran",
            "email": "kartikv2@gmail.com",
            "homepage": "http://www.krajee.com/"
        },
        {
            "name": "Stefano Mtangoo",
            "email": "mwinjilisti@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "yiisoft/yii2": "~2.0.55 || ^22.0@dev"
    },
    "require-dev": {
        "infection/infection": "^0.35",
        "maglnet/composer-require-checker": "^4.17",
        "php-forge/coding-standard": "^0.3.4",
        "phpstan/phpstan": "^2.3.5",
        "phpunit/phpunit": "^12.5"
    },
    "suggest": {
        "yiisoft/yii2-jquery": "Provides Yii 22 client script strategies for ActiveForm and other Yii widgets.",
        "yiisoft/yii2-bootstrap": "Optional Bootstrap 3 asset integration for Yii 2.0.",
        "yiisoft/yii2-bootstrap4": "Optional Bootstrap 4 asset integration for Yii 2.0.",
        "yiisoft/yii2-bootstrap5": "Optional Bootstrap 5 asset integration for Yii 2.0."
    },
    "autoload": {
        "psr-4": {
            "yii2\\extensions\\timepicker\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "yii2\\extensions\\timepicker\\tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        },
        "skills": {
            "source": "skills"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "yiisoft/yii2-composer": false
        }
    },
    "scripts": {
        "actionlint": "actionlint",
        "check-dependencies": "composer-require-checker check --config-file=composer-require-checker.json composer.json",
        "codespell": "codespell --config .github/linters/.codespellrc",
        "ecs-check": "ecs check",
        "editorconfig-checker": "editorconfig-checker -config .github/linters/.editorconfig-checker.json",
        "gitleaks": "gitleaks git --config .github/linters/.gitleaks.toml --redact",
        "markdownlint": "markdownlint-cli2 --config .github/linters/.markdown-lint.yml '**/*.md'",
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/infection --with-uncovered"
        ],
        "prettier": "prettier --check --config .prettierrc.json --ignore-path .prettierignore '**/*.md' '**/*.{yml,yaml}'",
        "quality": [
            "@actionlint",
            "@codespell",
            "@editorconfig-checker",
            "@markdownlint",
            "@prettier",
            "@yamllint"
        ],
        "security": [
            "@zizmor",
            "@gitleaks"
        ],
        "static": "phpstan analyse --no-progress",
        "tests": "phpunit",
        "yamllint": "yamllint -c .github/linters/.yamllint.yml .github",
        "zizmor": "zizmor --persona=pedantic .github"
    },
    "scripts-descriptions": {
        "actionlint": "Lints GitHub Actions workflows with actionlint.",
        "check-dependencies": "Verifies that used symbols are declared as Composer dependencies.",
        "codespell": "Checks spelling with codespell.",
        "ecs-check": "Checks coding standards with ECS without modifying files.",
        "editorconfig-checker": "Checks files against the EditorConfig rules.",
        "gitleaks": "Scans Git history for secrets with Gitleaks.",
        "markdownlint": "Lints Markdown files with markdownlint-cli2.",
        "mutation": "Runs mutation testing with Infection.",
        "prettier": "Checks Markdown and YAML formatting with Prettier.",
        "quality": "Runs all repository quality checks.",
        "security": "Runs the workflow security and secret scanning checks.",
        "static": "Runs static analysis with PHPStan.",
        "tests": "Runs PHPUnit.",
        "yamllint": "Lints YAML files with yamllint.",
        "zizmor": "Audits GitHub Actions workflows with zizmor."
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
